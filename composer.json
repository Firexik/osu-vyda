{
    "name": "firexik/vyda-terminy",
    "description": "Semestralni projekt VYDA: zapis studentu na zkousky a zapocty v Nette.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "nette/application": "^3.2",
        "nette/bootstrap": "^3.2",
        "nette/database": "^3.2",
        "nette/forms": "^3.2",
        "nette/security": "^3.2",
        "nette/robot-loader": "^4.0",
        "latte/latte": "^3.1",
        "tracy/tracy": "^2.10"
    },
    "autoload": {"psr-4": {"App\\": "app/"}},
    "scripts": {
        "serve": "@php -S 127.0.0.1:8000 -t www www/router.php"
    },
    "config": {"sort-packages": true, "allow-plugins": false}
