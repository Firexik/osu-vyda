{block title}Změna hesla{/block}

{block content}
{include 'header.latte'}
<section class="card form-card">
    <h1>{include title}</h1>
    <form n:name="changePasswordForm" class="fields">
        <p n:foreach="$form->getErrors() as $error" class="message error" role="alert">{$error}</p>
        <div>
            {label oldPassword /}
            <input n:name="oldPassword">
        </div>
        <div>
            {label newPassword /}
            <input n:name="newPassword">
        </div>
        <div>
            {label confirmPassword /}
            <input n:name="confirmPassword">
        </div>
        <button n:name="send" class="button">{$form['send']->getCaption()}</button>
    </form>
</section>
